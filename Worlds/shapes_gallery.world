# Shapes Gallery
# Six primitive shapes dropped from height onto a flat ground, one of each type:
#   Sphere, Box (AABB), Cylinder, Pyramid, Cone, Capsule
# Tests: every collider/plane pair — including the newly added AABB/Plane,
#        Cone/Plane, and Capsule/Plane — and each shape bouncing off the floor.

BeginSettings
  ClearColor = 0.05, 0.05, 0.08, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.22, 0.22, 0.26
  Roughness = 0.95
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = SphereMat
  AlbedoColor = 0.9, 0.2, 0.2
  Roughness = 0.25
  Metallic = 0.1
EndMaterial

BeginMaterial
  Name = BoxMat
  AlbedoColor = 0.95, 0.55, 0.1
  Roughness = 0.6
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = CylinderMat
  AlbedoColor = 0.9, 0.85, 0.1
  Roughness = 0.4
  Metallic = 0.1
EndMaterial

BeginMaterial
  Name = PyramidMat
  AlbedoColor = 0.2, 0.8, 0.3
  Roughness = 0.5
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = ConeMat
  AlbedoColor = 0.1, 0.75, 0.9
  Roughness = 0.3
  Metallic = 0.2
EndMaterial

BeginMaterial
  Name = CapsuleMat
  AlbedoColor = 0.7, 0.25, 0.95
  Roughness = 0.2
  Metallic = 0.3
EndMaterial

BeginMesh
  Name = Ground
  Type = plane
  Width = 80.0
  Height = 30.0
EndMesh

BeginMesh
  Name = Ball
  Type = sphere
  Radius = 0.55
  Segments = 24
EndMesh

BeginMesh
  Name = Box
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = Cyl
  Type = cylinder
  Radius = 0.45
  Height = 1.1
  Segments = 24
EndMesh

BeginMesh
  Name = Pyr
  Type = pyramid
  Size = 1.0
  Height = 1.2
EndMesh

BeginMesh
  Name = Cone
  Type = cone
  Radius = 0.5
  Height = 1.2
  Segments = 24
EndMesh

BeginMesh
  Name = Capsule
  Type = capsule
  Radius = 0.38
  Height = 1.4
  Segments = 24
EndMesh

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Ground
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 40.0, 0.0, 15.0
EndObject

BeginObject
  Name = Sphere
  Position = -12.5, 9.0, 0.0
  Mesh = Ball
  Material = SphereMat
  Mass = 1.0
  Restitution = 0.65
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.55
EndObject

BeginObject
  Name = Box
  Position = -7.5, 9.0, 0.0
  Mesh = Box
  Material = BoxMat
  Mass = 2.0
  Restitution = 0.35
  Damping = 0.99
  UseGravity = true
  Collider = box
  ColliderHalfExtents = 0.5, 0.5, 0.5
EndObject

BeginObject
  Name = Cylinder
  Position = -2.5, 9.0, 0.0
  Mesh = Cyl
  Material = CylinderMat
  Mass = 1.5
  Restitution = 0.45
  Damping = 0.99
  UseGravity = true
  Collider = cylinder
  ColliderRadius = 0.45
  ColliderHeight = 1.1
EndObject

BeginObject
  Name = Pyramid
  Position = 2.5, 9.0, 0.0
  Mesh = Pyr
  Material = PyramidMat
  Mass = 1.8
  Restitution = 0.30
  Damping = 0.99
  UseGravity = true
  Collider = box
  ColliderHalfExtents = 0.5, 0.6, 0.5
EndObject

BeginObject
  Name = Cone
  Position = 7.5, 9.0, 0.0
  Mesh = Cone
  Material = ConeMat
  Mass = 1.2
  Restitution = 0.40
  Damping = 0.99
  UseGravity = true
  Collider = cone
  ColliderRadius = 0.5
  ColliderHeight = 1.2
EndObject

BeginObject
  Name = Capsule
  Position = 12.5, 9.0, 0.0
  Mesh = Capsule
  Material = CapsuleMat
  Mass = 1.0
  Restitution = 0.55
  Damping = 0.99
  UseGravity = true
  Collider = capsule
  ColliderRadius = 0.38
  ColliderHeight = 1.4
EndObject

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.4, -1.0, 0.3
  Color = 1.0, 0.97, 0.90
  Intensity = 2.3
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 18.0, 8.0
  Color = 0.6, 0.7, 1.0
  Intensity = 1.8
  CastsShadows = false
EndLight
