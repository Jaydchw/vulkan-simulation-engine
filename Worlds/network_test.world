# ---- Lighting ----

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.35, -1.0, 0.45
  Color = 1.0, 0.97, 0.90
  Intensity = 2.8
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 20.0, 0.0
  Color = 0.5, 0.6, 0.9
  Intensity = 1.2
  CastsShadows = false
EndLight
