BeginSettings
  ClearColor = 0.04, 0.05, 0.08, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
  MaxFps = 30
EndSettings

BeginTexture
  Name = StripeLight
  Type = stripe
  ColorA = 0.95, 0.95, 0.95
  ColorB = 0.15, 0.15, 0.15
  Size = 256
  StripeCount = 10
  Vertical = true
EndTexture

BeginTexture
  Name = GroundTex
  Type = checker
  ColorA = 0.28, 0.28, 0.32
  ColorB = 0.18, 0.18, 0.22
  Size = 512
  Divisions = 20
EndTexture

BeginMaterial
  Name = GroundMat
  AlbedoColor = 1.0, 1.0, 1.0
