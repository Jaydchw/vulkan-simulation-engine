# ---- Planet 4: magenta, R=4, T=3s (inner fast, inclined plane) ----

BeginObject
  Name = Planet 4 (Magenta)
  Position = 4.0, 2.0, 0.0
  Mesh = p4_mesh
  Material = mat_p4_magenta
  BeginAnimation
    PathMode = loop
