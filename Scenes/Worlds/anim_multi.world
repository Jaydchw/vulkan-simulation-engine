    BeginWaypoint
      Position = -9.0, 0.0, 0.0
      Rotation = 0.0, 180.0, 0.0
      Time = 4.5
    EndWaypoint
    BeginWaypoint
      Position = -4.5, -0.6, 7.79
      Rotation = 0.0, 240.0, 0.0
      Time = 6.0
    EndWaypoint
    BeginWaypoint
      Position = 4.5, -0.8, 7.79
      Rotation = 0.0, 300.0, 0.0
      Time = 7.5
    EndWaypoint
  EndAnimation
EndObject

