# ---- Planet 5: outer purple, R=21, T=26s (slow, slightly tilted) ----

BeginObject
  Name = Planet 5 (Purple)
  Position = 21.0, 0.0, 0.0
  Mesh = p5_mesh
  Material = mat_p5_purple
  BeginAnimation
    PathMode = loop
    Easing = smoothstep
    TotalDuration = 26.0
    BeginWaypoint
      Position = 21.0, 0.0, 0.0
      Rotation = 0.0, 0.0, 0.0
      Time = 0.0
    EndWaypoint
    BeginWaypoint
      Position = 10.5, -1.2, -18.19
      Rotation = 0.0, 60.0, 0.0
      Time = 4.33
    EndWaypoint
    BeginWaypoint
      Position = -10.5, 0.0, -18.19
      Rotation = 0.0, 120.0, 0.0
      Time = 8.67
    EndWaypoint
    BeginWaypoint
      Position = -21.0, 0.0, 0.0
      Rotation = 0.0, 180.0, 0.0
      Time = 13.0
    EndWaypoint
    BeginWaypoint
      Position = -10.5, 1.5, 18.19
      Rotation = 0.0, 240.0, 0.0
