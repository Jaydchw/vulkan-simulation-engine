# Shapes Mix: spheres, cylinders, capsules, and cones dropping onto animated platforms
# A variety of collider types interact with two sweeping platforms and a rising wedge.

BeginSettings
  ClearColor = 0.04, 0.05, 0.09, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.20, 0.20, 0.25
  Roughness = 0.90
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = PlatformA
  AlbedoColor = 0.15, 0.50, 0.80
  Roughness = 0.30
  Metallic = 0.50
EndMaterial

BeginMaterial
  Name = PlatformB
  AlbedoColor = 0.80, 0.40, 0.10
  Roughness = 0.30
  Metallic = 0.50
EndMaterial

BeginMaterial
  Name = MatSphere
  AlbedoColor = 0.95, 0.95, 0.95
  Roughness = 0.20
  Metallic = 0.05
EndMaterial

BeginMaterial
  Name = MatCylinder
  AlbedoColor = 0.30, 0.85, 0.55
  Roughness = 0.35
  Metallic = 0.20
EndMaterial

BeginMaterial
  Name = MatCapsule
  AlbedoColor = 0.95, 0.65, 0.15
  Roughness = 0.25
  Metallic = 0.10
EndMaterial

BeginMaterial
  Name = MatCone
  AlbedoColor = 0.85, 0.25, 0.30
  Roughness = 0.40
  Metallic = 0.15
EndMaterial

BeginMesh
  Name = Floor
  Type = plane
  Width = 60.0
  Height = 60.0
EndMesh

BeginMesh
  Name = Slab
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = MSphere
  Type = sphere
  Radius = 0.8
  Segments = 28
EndMesh

BeginMesh
  Name = MCylinder
  Type = cylinder
  Radius = 0.6
  Height = 1.4
  Segments = 24
EndMesh

BeginMesh
  Name = MCapsule
  Type = capsule
  Radius = 0.5
  Height = 1.2
  Segments = 24
EndMesh

BeginMesh
  Name = MCone
  Type = cone
  Radius = 0.7
  Height = 1.5
  Segments = 24
EndMesh

# Static ground
BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 30.0, 0.0, 30.0
EndObject

# Blue platform sweeping left-right at mid height
BeginObject
  Name = Platform A
  Position = -8.0, 5.0, 0.0
  Scale = 7.0, 0.5, 4.0
  Mesh = Slab
  Material = PlatformA
  Collider = box
  ColliderHalfExtents = 3.5, 0.25, 2.0
  BeginAnimation
    PathMode = reverse
    Easing = smoothstep
    TotalDuration = 5.0
    BeginWaypoint
      Position = -8.0, 5.0, 0.0
      Rotation = 0.0, 0.0, 0.0
      Time = 0.0
    EndWaypoint
    BeginWaypoint
      Position = 8.0, 5.0, 0.0
      Rotation = 0.0, 0.0, 0.0
      Time = 5.0
    EndWaypoint
  EndAnimation
EndObject

# Orange platform rising and falling, offset in Z
BeginObject
  Name = Platform B
  Position = 0.0, 2.0, -8.0
  Scale = 5.0, 0.5, 5.0
  Mesh = Slab
  Material = PlatformB
  Collider = box
  ColliderHalfExtents = 2.5, 0.25, 2.5
  BeginAnimation
    PathMode = reverse
    Easing = smoothstep
    TotalDuration = 3.5
    BeginWaypoint
      Position = 0.0, 2.0, -8.0
      Rotation = 0.0, 0.0, 0.0
      Time = 0.0
    EndWaypoint
    BeginWaypoint
      Position = 0.0, 9.0, -8.0
      Rotation = 0.0, 0.0, 0.0
      Time = 3.5
    EndWaypoint
  EndAnimation
EndObject

# --- Physics shapes ---

BeginObject
  Name = Sphere 1
  Position = -4.0, 22.0, 0.5
  Mesh = MSphere
  Material = MatSphere
  Physics = true
  Restitution = 0.65
  Mass = 1.0
  Collider = sphere
  ColliderRadius = 0.8
EndObject

BeginObject
  Name = Sphere 2
  Position = 3.0, 26.0, -0.5
  Mesh = MSphere
  Material = MatSphere
  Physics = true
  Restitution = 0.70
  Mass = 1.0
  Collider = sphere
  ColliderRadius = 0.8
EndObject

BeginObject
  Name = Cylinder 1
  Position = -2.0, 20.0, 1.0
  Mesh = MCylinder
  Material = MatCylinder
  Physics = true
  Restitution = 0.45
  Mass = 1.5
  Collider = cylinder
  ColliderRadius = 0.6
  ColliderHeight = 1.4
EndObject

BeginObject
  Name = Cylinder 2
  Position = 5.0, 24.0, -2.0
  Mesh = MCylinder
  Material = MatCylinder
  Physics = true
  Restitution = 0.40
  Mass = 1.5
  Collider = cylinder
  ColliderRadius = 0.6
  ColliderHeight = 1.4
EndObject

BeginObject
  Name = Capsule 1
  Position = 1.0, 18.0, 3.0
  Mesh = MCapsule
  Material = MatCapsule
  Physics = true
  Restitution = 0.55
  Mass = 1.2
  Collider = capsule
  ColliderRadius = 0.5
  ColliderHeight = 1.2
EndObject

BeginObject
  Name = Capsule 2
  Position = -5.0, 30.0, -1.0
  Mesh = MCapsule
  Material = MatCapsule
  Physics = true
  Restitution = 0.60
  Mass = 1.0
  Collider = capsule
  ColliderRadius = 0.5
  ColliderHeight = 1.2
EndObject

BeginObject
  Name = Cone 1
  Position = 2.0, 16.0, -3.0
  Mesh = MCone
  Material = MatCone
  Physics = true
  Restitution = 0.35
  Mass = 2.0
  Collider = cone
  ColliderRadius = 0.7
  ColliderHeight = 1.5
EndObject

BeginObject
  Name = Cone 2
  Position = -3.0, 28.0, 2.0
  Mesh = MCone
  Material = MatCone
  Physics = true
  Restitution = 0.30
  Mass = 2.0
  Collider = cone
  ColliderRadius = 0.7
  ColliderHeight = 1.5
EndObject

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.25, -1.0, 0.35
  Color = 1.0, 0.96, 0.90
  Intensity = 2.8
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 20.0, 8.0
  Color = 0.35, 0.45, 0.70
  Intensity = 150.0
  CastsShadows = false
EndLight
