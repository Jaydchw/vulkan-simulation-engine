  Name = NeonBlue
  Type = point
  Position = -5.0, 15.0, 2.0
  Color = 0.3, 0.6, 1.0
  Intensity = 50.0
  Linear = 0.08
  Quadratic = 0.016
  CastsShadows = false
EndLight

BeginLight
  Name = NeonOrange
  Type = point
  Position = 5.0, 32.0, 2.0
  Color = 1.0, 0.5, 0.15
  Intensity = 40.0
  Linear = 0.08
  Quadratic = 0.016
  CastsShadows = false
EndLight

BeginLight
  Name = GatePurple
  Type = point
  Position = 0.0, 9.0, 0.0
  Color = 0.75, 0.15, 1.0
  Intensity = 35.0
  Linear = 0.10
  Quadratic = 0.022
  CastsShadows = false
EndLight

BeginLight
  Name = SliderCyan
  Type = point
  Position = 0.0, 18.0, 0.0
  Color = 0.15, 0.85, 1.0
  Intensity = 30.0
  Linear = 0.12
  Quadratic = 0.026
  CastsShadows = false
EndLight

BeginCamera
  Name = MainCamera
  Position = -22.0, 30.0, -26.0
  Target = 0.0, 20.0, 0.0
  FOV = 75
EndCamera
