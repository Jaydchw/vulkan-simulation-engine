BeginLight
  Name = TopDown
  Type = point
  Position = 0.0, 50.0, 0.0
  Color = 0.95, 0.90, 0.80
  Intensity = 80.0
  Linear = 0.030
  Quadratic = 0.003
  CastsShadows = true
EndLight

