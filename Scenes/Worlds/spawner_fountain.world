# ---- Lights ----

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.3, -0.9, 0.4
  Color = 1.0, 0.96, 0.88
  Intensity = 2.4
  CastsShadows = true
EndLight

BeginLight
  Name = FountainGlow
  Type = point
  Position = 0.0, 6.0, 0.0
  Color = 0.6, 0.85, 1.0
  Intensity = 40.0
  Linear = 0.06
  Quadratic = 0.012
  CastsShadows = false
EndLight

BeginLight
  Name = AmbientFill
