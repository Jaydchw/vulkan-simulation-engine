  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 0.75, 0.5, 7.0
EndObject

BeginObject
  Name = Basin_NE
  Position = 13.0, 0.5, 13.0
  Rotation = 0.0, 45.0, 0.0
  Scale = 1.5, 1.0, 12.0
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 0.75, 0.5, 6.0
EndObject

BeginObject
  Name = Basin_NW
  Position = -13.0, 0.5, 13.0
  Rotation = 0.0, -45.0, 0.0
  Scale = 1.5, 1.0, 12.0
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 0.75, 0.5, 6.0
EndObject

BeginObject
  Name = Basin_SE
  Position = 13.0, 0.5, -13.0
  Rotation = 0.0, -45.0, 0.0
  Scale = 1.5, 1.0, 12.0
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 0.75, 0.5, 6.0
EndObject

BeginObject
  Name = Basin_SW
  Position = -13.0, 0.5, -13.0
  Rotation = 0.0, 45.0, 0.0
  Scale = 1.5, 1.0, 12.0
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 0.75, 0.5, 6.0
EndObject

# Small central post / plinth
BeginObject
  Name = FountainPost
  Position = 0.0, 1.0, 0.0
  Mesh = post_mesh
  Material = BasinMat
EndObject

# ============================================================
# SPAWNERS — five on a ring of radius 4, pointing up-and-out
# Directions are (outward * 0.35 + up * 1.0) pre-normalised roughly
# ============================================================

# Spawner 0° (East)
BeginSpawner
  Name = Fountain_E
  Position = 4.0, 1.2, 0.0
  SpawnDirection = 1.0, 2.8, 0.0
  DirectionRandomness = 0.22
  SpawnSpeed = 14.0
  SpeedRandomness = 0.20
  SpawnInterval = 0.20
  SpawnIntervalRandomness = 0.35
  PositionRandomness = 0.4
  AngularVelocityRandomness = 6.0
  MaxSpawns = 200
  BeginTemplate
    Weight = 1.0
    NamePrefix = FE
    Mesh = ball_mesh
    Material = BallRed
    Mass = 0.5
    Restitution = 0.60
    Damping = 0.99
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.55
  EndTemplate
EndSpawner

