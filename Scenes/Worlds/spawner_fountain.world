# Spawner Fountain
# Five spawners arranged in a ring shoot colourful balls upward and outward.
# Gravity arcs them back down onto the floor, creating a cascading fountain effect.

BeginSettings
  ClearColor = 0.06, 0.08, 0.14, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
  KillboxEnabled = true
  KillboxY = -5.0
EndSettings

# ---- Materials ----

BeginTexture
  Name = GridTex
  Type = checker
  ColorA = 0.32, 0.38, 0.45
  ColorB = 0.15, 0.20, 0.28
  Divisions = 16
  Size = 256
EndTexture

BeginMaterial
  Name = FloorMat
  AlbedoColor = 0.30, 0.32, 0.38
  Roughness = 0.85
  Metallic = 0.05
  AlbedoTexture = GridTex
EndMaterial

BeginMaterial
  Name = BasinMat
  AlbedoColor = 0.22, 0.25, 0.32
  Roughness = 0.70
  Metallic = 0.10
EndMaterial

BeginMaterial
  Name = BallRed
  AlbedoColor = 0.95, 0.22, 0.18
  Roughness = 0.22
  Metallic = 0.35
EndMaterial

BeginMaterial
  Name = BallOrange
  AlbedoColor = 1.00, 0.55, 0.10
  Roughness = 0.20
  Metallic = 0.40
EndMaterial

BeginMaterial
  Name = BallYellow
  AlbedoColor = 0.98, 0.88, 0.15
  Roughness = 0.18
  Metallic = 0.45
EndMaterial

BeginMaterial
  Name = BallGreen
  AlbedoColor = 0.20, 0.88, 0.35
  Roughness = 0.22
  Metallic = 0.38
EndMaterial

BeginMaterial
  Name = BallBlue
  AlbedoColor = 0.18, 0.50, 1.00
  Roughness = 0.20
  Metallic = 0.42
EndMaterial

# ---- Meshes ----

BeginMesh
  Name = floor_plane
  Type = plane
  Width = 70.0
  Height = 70.0
EndMesh

BeginMesh
  Name = basin_wall
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = ball_mesh
  Type = sphere
  Radius = 0.55
  Segments = 20
EndMesh

BeginMesh
  Name = post_mesh
  Type = cylinder
  Radius = 0.22
  Height = 2.0
  Segments = 8
EndMesh

# ============================================================
# FLOOR + LOW CIRCULAR BASIN WALLS
# ============================================================

BeginObject
  Name = Floor
  Position = 0.0, 0.0, 0.0
  Mesh = floor_plane
  Material = FloorMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 35.0, 0.0, 35.0
EndObject

# Eight low curved-ish basin wall segments arranged in a ring
BeginObject
  Name = Basin_N
  Position = 0.0, 0.5, 18.0
  Scale = 14.0, 1.0, 1.5
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 7.0, 0.5, 0.75
EndObject

BeginObject
  Name = Basin_S
  Position = 0.0, 0.5, -18.0
  Scale = 14.0, 1.0, 1.5
  Mesh = basin_wall
  Material = BasinMat
  Collider = box
  ColliderHalfExtents = 7.0, 0.5, 0.75
EndObject

BeginObject
  Name = Basin_E
