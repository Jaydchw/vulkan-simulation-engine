# Cloth Gravity Demo
# A cloth hangs from its top row and drapes over a static sphere below.

BeginSettings
  ClearColor = 0.06, 0.07, 0.12, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

BeginMaterial
  Name = ClothMat
  AlbedoColor = 0.85, 0.35, 0.25
  Roughness = 0.8
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = SphereMat
  AlbedoColor = 0.6, 0.7, 0.9
  Roughness = 0.2
  Metallic = 0.6
EndMaterial

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.3, 0.32, 0.35
  Roughness = 0.95
  Metallic = 0.0
EndMaterial

BeginMesh
  Name = SphereObstacle
  Type = sphere
  Radius = 2.5
  Segments = 32
EndMesh

BeginMesh
  Name = Floor
  Type = plane
  Width = 40.0
  Height = 40.0
EndMesh

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 20.0, 0.0, 20.0
EndObject

BeginObject
  Name = Obstacle Sphere
  Position = 0.0, 2.5, -0.5
  Mesh = SphereObstacle
  Material = SphereMat
  Collider = sphere
  ColliderRadius = 2.5
EndObject

BeginCloth
  Name = Hanging Cloth
  Position = 0.0, 16.0, -0.5
  Material = ClothMat
  ResolutionX = 18
  ResolutionZ = 16
  Width = 9.0
  ClothHeight = 10.0
  StructuralStiffness = 0.85
  BendingStiffness = 0.08
  Damping = 0.99
  ParticleMass = 0.07
  UseGravity = true
  Hinge = TopRow
  Wind = 0.0, 0.0, 0.0
EndCloth

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.4, -1.0, 0.5
  Color = 1.0, 0.97, 0.88
  Intensity = 2.8
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = -8.0, 12.0, 8.0
  Color = 0.5, 0.6, 1.0
  Intensity = 80.0
  CastsShadows = false
EndLight
