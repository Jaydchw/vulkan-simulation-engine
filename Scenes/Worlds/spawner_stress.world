# Top-down sweeper
BeginSpawner
  Name = SpawnerTop
  Position = 0.0, 20.0, 0.0
  SpawnDirection = 0.0, -1.0, 0.0
  DirectionRandomness = 0.75
  SpawnSpeed = 22.0
  SpeedRandomness = 0.4
  SpawnInterval = 0.055
  SpawnIntervalRandomness = 0.3
  PositionRandomness = 8.0
  AngularVelocityRandomness = 15.0
  MaxSpawns = 350
  BeginTemplate
    Weight = 1.0
    NamePrefix = TopBall
    Mesh = stress_ball
    Material = BallC
    Mass = 0.28
    Restitution = 0.78
    Damping = 0.995
    UseGravity = false
    Collider = sphere
    ColliderRadius = 0.45
  EndTemplate
EndSpawner

# ---- Lights ----

BeginLight
  Name = LightA
  Type = point
  Position = 0.0, 22.0, 0.0
  Color = 0.9, 0.85, 0.75
  Intensity = 80.0
  Linear = 0.03
  Quadratic = 0.004
  CastsShadows = false
EndLight

BeginLight
  Name = LightB
  Type = point
  Position = 0.0, -20.0, 0.0
  Color = 0.4, 0.55, 1.0
  Intensity = 60.0
  Linear = 0.04
  Quadratic = 0.006
  CastsShadows = false
EndLight

BeginCamera
  Name = MainCamera
  Position = -8.0, 14.0, -44.0
  Target = 0.0, 0.0, 0.0
  FOV = 78
EndCamera
