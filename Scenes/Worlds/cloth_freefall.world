# Cloth Freefall Demo
# Cloth with no hinge — all particles free to move under gravity.
# The cloth falls as a sheet and crumples when it hits the ground.
# A spawner fires spheres from the side while it falls, showing mid-air deformation.

BeginSettings
  ClearColor = 0.06, 0.07, 0.12, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
  KillboxEnabled = true
  KillboxY = -3.0
EndSettings

BeginTexture
  Name = ClothGrid
  Type = checker
  ColorA = 0.95, 0.78, 0.20
  ColorB = 0.55, 0.40, 0.08
  Divisions = 16
  Size = 256
EndTexture

BeginTexture
  Name = GroundGrid
  Type = checker
  ColorA = 0.32, 0.30, 0.28
  ColorB = 0.16, 0.15, 0.14
  Divisions = 16
  Size = 256
EndTexture

BeginMaterial
  Name = ClothMat
  AlbedoColor = 0.90, 0.72, 0.18
  Roughness = 0.75
  Metallic = 0.0
  AlbedoTexture = ClothGrid
EndMaterial

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.28, 0.26, 0.25
  Roughness = 0.95
  Metallic = 0.0
  AlbedoTexture = GroundGrid
EndMaterial

BeginMaterial
  Name = BallMat
  AlbedoColor = 0.25, 0.65, 0.95
  Roughness = 0.25
  Metallic = 0.4
EndMaterial

BeginMesh
  Name = Floor
  Type = plane
  Width = 40.0
  Height = 40.0
EndMesh

BeginMesh
  Name = Ball
  Type = sphere
  Radius = 0.5
  Segments = 20
EndMesh

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 20.0, 0.0, 20.0
EndObject

BeginCloth
  Name = Freefall Cloth
  Position = 0.0, 16.0, 0.0
  Material = ClothMat
  ResolutionX = 18
  ResolutionZ = 16
  Width = 10.0
  ClothHeight = 10.0
  StructuralStiffness = 0.85
  BendingStiffness = 0.06
  Damping = 0.99
  ParticleMass = 0.07
  UseGravity = true
  Hinge = None
  Wind = 0.0, 0.0, 0.0
EndCloth

# Side spawner — fires spheres from the side into the falling cloth
BeginSpawner
  Name = SideSpawner
  Position = 12.0, 13.0, 0.0
  SpawnInterval = 0.7
  SpawnIntervalRandomness = 0.3
  SpawnDirection = -1.0, 0.1, 0.0
  DirectionRandomness = 0.18
  SpawnSpeed = 13.0
  SpeedRandomness = 0.25
  PositionRandomness = 1.0

  BeginTemplate
    Weight = 2.0
    NamePrefix = SB
    Mesh = Ball
    Material = BallMat
    ScaleUniform = 1.0
    Mass = 0.8
    Restitution = 0.4
    Damping = 0.99
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.5
  EndTemplate

  BeginTemplate
    Weight = 1.0
    NamePrefix = LB
    Mesh = Ball
    Material = BallMat
    ScaleUniform = 2.0
    Mass = 3.5
    Restitution = 0.3
    Damping = 0.99
    UseGravity = true
    Collider = sphere
    ColliderRadius = 1.0
  EndTemplate
EndSpawner

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.4, -1.0, 0.5
  Color = 1.0, 0.97, 0.88
  Intensity = 2.8
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = -6.0, 14.0, 8.0
  Color = 0.5, 0.6, 1.0
  Intensity = 60.0
  CastsShadows = false
EndLight
