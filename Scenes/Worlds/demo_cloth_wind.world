# Cloth Wind Demo
# A cloth is pinned at its top row and blown sideways by wind.
# A cylinder stands in front as an obstacle.

BeginSettings
  ClearColor = 0.08, 0.10, 0.15, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

BeginMaterial
  Name = ClothMat
  AlbedoColor = 0.2, 0.65, 0.4
  Roughness = 0.85
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = PillarMat
  AlbedoColor = 0.7, 0.65, 0.5
  Roughness = 0.7
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.28, 0.30, 0.33
  Roughness = 0.95
  Metallic = 0.0
EndMaterial

BeginMesh
  Name = Pillar
  Type = cylinder
  Radius = 0.8
  Height = 14.0
  Segments = 20
EndMesh

BeginMesh
  Name = Floor
  Type = plane
  Width = 50.0
  Height = 50.0
EndMesh

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 25.0, 0.0, 25.0
EndObject

BeginObject
  Name = Pillar
  Position = -7.0, 7.0, 0.0
  Mesh = Pillar
  Material = PillarMat
  Collider = cylinder
  ColliderRadius = 0.8
  ColliderHeight = 14.0
EndObject

BeginCloth
  Name = Wind Cloth
  Position = -2.0, 15.0, 0.0
  Material = ClothMat
  ResolutionX = 20
  ResolutionZ = 16
  Width = 10.0
  ClothHeight = 10.0
  StructuralStiffness = 0.85
  BendingStiffness = 0.06
  Damping = 0.985
  ParticleMass = 0.06
  UseGravity = true
  Hinge = LeftCol
  Wind = 4.5, 0.0, 1.0
EndCloth

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.3, -1.0, 0.4
  Color = 1.0, 0.96, 0.85
  Intensity = 2.5
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = -5.0, 14.0, 10.0
  Color = 0.5, 0.7, 1.0
  Intensity = 90.0
  CastsShadows = false
EndLight
