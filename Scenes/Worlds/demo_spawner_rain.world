# Demo: Spawner Rain
# A high-rate multi-template spawner rains objects onto a central A-frame ramp.
# Three templates: small bouncy spheres (common), medium boxes (uncommon), large heavy spheres (rare).
# The ramp splits the rain left and right so you can watch the pile build up.
# Template weighting means you see roughly 6:2.5:1.5 spheres:boxes:boulders.

BeginSettings
  ClearColor = 0.04, 0.06, 0.12, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

# ---- Materials ----

BeginMaterial
  Name = ArenaMat
  AlbedoColor = 0.25, 0.25, 0.30
  Roughness = 0.90
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = RampMat
  AlbedoColor = 0.40, 0.35, 0.28
  Roughness = 0.75
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = BallMat
  AlbedoColor = 0.20, 0.70, 1.00
  Roughness = 0.20
  Metallic = 0.40
EndMaterial

BeginMaterial
  Name = BoxMat
  AlbedoColor = 0.80, 0.40, 0.15
  Roughness = 0.65
  Metallic = 0.05
EndMaterial

BeginMaterial
  Name = HeavyMat
  AlbedoColor = 0.70, 0.15, 0.15
  Roughness = 0.50
  Metallic = 0.30
EndMaterial

# ---- Meshes ----

BeginMesh
  Name = Floor
  Type = plane
  Width = 50.0
  Height = 50.0
EndMesh

BeginMesh
  Name = Ramp
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = SmBall
  Type = sphere
  Radius = 0.45
  Segments = 20
EndMesh

BeginMesh
  Name = Box
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = LgBall
  Type = sphere
  Radius = 1.10
  Segments = 24
EndMesh

# ---- Static arena ----

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = ArenaMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 25.0, 0.0, 25.0
EndObject

# Central A-frame ramp — splits the rain left and right
BeginObject
  Name = Ramp Left
  Position = -5.0, 1.8, 0.0
  Rotation = 0.0, 0.0, 22.0
  Scale = 10.0, 0.5, 18.0
  Mesh = Ramp
  Material = RampMat
  Collider = box
  ColliderHalfExtents = 5.0, 0.25, 9.0
EndObject

BeginObject
  Name = Ramp Right
  Position = 5.0, 1.8, 0.0
  Rotation = 0.0, 0.0, -22.0
  Scale = 10.0, 0.5, 18.0
  Mesh = Ramp
  Material = RampMat
  Collider = box
  ColliderHalfExtents = 5.0, 0.25, 9.0
EndObject

# ---- Spawner ----

BeginSpawner
  Name = Rain
  Position = 0.0, 20.0, 0.0
  SpawnInterval = 0.18
  SpawnIntervalRandomness = 0.35
  SpawnDirection = 0.0, -1.0, 0.0
  DirectionRandomness = 0.10
  SpawnSpeed = 1.0
  SpeedRandomness = 0.20
  PositionRandomness = 8.0
  AngularVelocityRandomness = 5.0
  MaxSpawns = 120

  # Small bouncy ball — most common
  BeginTemplate
    Weight = 6.0
    NamePrefix = Drop
    Mesh = SmBall
    Material = BallMat
    ScaleUniform = 1.0
    Mass = 0.4
    Restitution = 0.72
    Damping = 0.99
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.45
  EndTemplate

  # Medium box — less common
  BeginTemplate
    Weight = 2.5
    NamePrefix = Crate
    Mesh = Box
    Material = BoxMat
    ScaleUniform = 0.8
    Mass = 3.0
    Restitution = 0.25
    Damping = 0.98
    UseGravity = true
    Collider = box
    ColliderHalfExtents = 0.4, 0.4, 0.4
  EndTemplate

  # Large heavy sphere — rare
  BeginTemplate
    Weight = 1.5
    NamePrefix = Boulder
    Mesh = LgBall
    Material = HeavyMat
    ScaleUniform = 1.0
    Mass = 12.0
    Restitution = 0.30
    Damping = 0.99
    UseGravity = true
    Collider = sphere
    ColliderRadius = 1.10
  EndTemplate

EndSpawner

# ---- Lighting ----

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.30, -1.0, 0.40
  Color = 1.0, 0.96, 0.88
  Intensity = 2.6
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 22.0, 0.0
  Color = 0.45, 0.55, 0.90
  Intensity = 80.0
  CastsShadows = false
EndLight
