# Cityscape Showcase
# A static city at night: skyscrapers, street lamps, parked cars, trees.
# No physics, no spawners — pure visual showcase of static objects and procedural textures.
# Layout: two roads crossing at origin, four city blocks with buildings in each quadrant.

BeginSettings
  ClearColor = 0.0, 0.0, 0.02, 1.0
  TimeSpeed = 1.0
  SimulationHz = 60
  KillboxEnabled = false
EndSettings

# ============================================================
# TEXTURES
# ============================================================

BeginTexture
  Name = tex_asphalt
  Type = solid
  Color = 0.12, 0.12, 0.14
  Size = 256
EndTexture

BeginTexture
  Name = tex_sidewalk
  Type = stripe
  ColorA = 0.62, 0.62, 0.65
  ColorB = 0.55, 0.55, 0.58
  Size = 256
  StripeCount = 12
  Vertical = false
EndTexture

BeginTexture
  Name = tex_concrete
  Type = gradient
  ColorA = 0.55, 0.55, 0.58
  ColorB = 0.38, 0.38, 0.42
  Size = 256
  Vertical = true
EndTexture

BeginTexture
  Name = tex_glass_blue
  Type = solid
  Color = 0.18, 0.35, 0.62
  Size = 256
EndTexture

BeginTexture
  Name = tex_glass_dark
  Type = solid
  Color = 0.08, 0.14, 0.28
  Size = 256
EndTexture

BeginTexture
  Name = tex_brick
  Type = stripe
  ColorA = 0.52, 0.28, 0.18
  ColorB = 0.44, 0.36, 0.28
  Size = 256
  StripeCount = 18
  Vertical = false
EndTexture

BeginTexture
  Name = tex_road_line
  Type = solid
  Color = 0.85, 0.82, 0.55
  Size = 64
EndTexture

BeginTexture
  Name = tex_ground
  Type = solid
  Color = 0.09, 0.09, 0.10
  Size = 256
EndTexture

BeginTexture
  Name = tex_roof
  Type = checker
  ColorA = 0.20, 0.20, 0.22
  ColorB = 0.15, 0.15, 0.17
  Size = 128
  Divisions = 4
EndTexture

BeginTexture
  Name = tex_lamp_warm
  Type = solid
  Color = 1.0, 0.92, 0.7
  Size = 64
EndTexture

BeginTexture
  Name = tex_car_red
  Type = solid
  Color = 0.80, 0.10, 0.10
  Size = 64
EndTexture

BeginTexture
  Name = tex_car_blue
  Type = solid
  Color = 0.12, 0.25, 0.75
  Size = 64
EndTexture

BeginTexture
  Name = tex_car_yellow
  Type = solid
  Color = 0.85, 0.72, 0.08
  Size = 64
EndTexture

BeginTexture
  Name = tex_car_white
  Type = solid
  Color = 0.88, 0.88, 0.90
  Size = 64
EndTexture

BeginTexture
  Name = tex_tree_bark
  Type = solid
  Color = 0.30, 0.18, 0.09
  Size = 64
EndTexture

BeginTexture
  Name = tex_tree_top
  Type = radial
  ColorA = 0.15, 0.42, 0.12
  ColorB = 0.08, 0.28, 0.08
  Size = 128
EndTexture

