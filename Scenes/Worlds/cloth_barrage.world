# Cloth Barrage
# A large cloth hangs from its top row.
# Three spawners in front fire balls perpendicular to the cloth face.
# No floor — balls eventually fall out of frame and are removed by the killbox.

BeginSettings
  ClearColor = 0.04, 0.04, 0.10, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
  KillboxEnabled = true
  KillboxY = -60.0
EndSettings

# ---- Materials ----

BeginTexture
  Name = tex_cloth_barrage
  Type = checker
  ColorA = 0.85, 0.25, 0.25
  ColorB = 0.95, 0.88, 0.75
  Size = 512
  Divisions = 16
EndTexture

BeginMaterial
  Name = ClothMat
  AlbedoColor = 0.9, 0.55, 0.55
  Roughness = 0.82
  Metallic = 0.0
  AlbedoTexture = tex_cloth_barrage
EndMaterial

BeginMaterial
  Name = BallMatA
  AlbedoColor = 0.2, 0.65, 1.0
  Roughness = 0.2
  Metallic = 0.5
EndMaterial

BeginMaterial
  Name = BallMatB
  AlbedoColor = 0.15, 0.85, 0.35
  Roughness = 0.25
  Metallic = 0.4
EndMaterial

BeginMaterial
  Name = BallMatC
  AlbedoColor = 1.0, 0.6, 0.1
  Roughness = 0.3
  Metallic = 0.35
EndMaterial

# ---- Meshes ----

BeginMesh
  Name = ball_sm
  Type = sphere
  Radius = 0.55
  Segments = 20
EndMesh

BeginMesh
  Name = ball_lg
  Type = sphere
  Radius = 1.1
  Segments = 24
EndMesh

# ---- Cloth ----
# EulerAngles = 90, 0, 0 rotates the cloth from horizontal to vertical
# so it hangs as a curtain pinned at its top row.

BeginCloth
  Name = BarrageCloth
  Position = 0.0, 12.0, 0.0
  Material = ClothMat
  ResolutionX = 24
  ResolutionZ = 18
  Width = 32.0
  ClothHeight = 24.0
  StructuralStiffness = 0.88
  BendingStiffness = 0.07
  Damping = 0.988
  ParticleMass = 0.07
  UseGravity = true
  EulerAngles = 90.0, 0.0, 0.0
  Hinge = TopRow
  SolverIterations = 8
  Tearability = 2.2
EndCloth

# ---- Spawners — three positions spread across the cloth width ----

BeginSpawner
  Name = SpawnerLeft
  Position = -11.0, 10.0, 22.0
  SpawnDirection = 0.0, 0.0, -1.0
  DirectionRandomness = 0.18
  SpawnSpeed = 18.0
  SpeedRandomness = 0.25
  SpawnInterval = 0.30
  SpawnIntervalRandomness = 0.4
  PositionRandomness = 1.2
  MaxSpawns = -1
  BeginTemplate
    Weight = 3.0
    NamePrefix = BoltL
    Mesh = ball_sm
    Material = BallMatA
    Mass = 0.5
    Restitution = 0.35
    Damping = 0.97
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.55
  EndTemplate
  BeginTemplate
    Weight = 1.0
    NamePrefix = HeavyL
    Mesh = ball_lg
    Material = BallMatC
    Mass = 3.0
    Restitution = 0.25
    Damping = 0.98
    UseGravity = true
    Collider = sphere
    ColliderRadius = 1.1
  EndTemplate
EndSpawner

BeginSpawner
  Name = SpawnerCenter
  Position = 0.0, 12.0, 22.0
  SpawnDirection = 0.0, 0.0, -1.0
  DirectionRandomness = 0.15
  SpawnSpeed = 20.0
  SpeedRandomness = 0.2
  SpawnInterval = 0.22
  SpawnIntervalRandomness = 0.3
  PositionRandomness = 1.0
  MaxSpawns = -1
  BeginTemplate
    Weight = 2.0
    NamePrefix = BoltC
    Mesh = ball_sm
    Material = BallMatB
    Mass = 0.45
    Restitution = 0.38
    Damping = 0.97
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.55
  EndTemplate
  BeginTemplate
    Weight = 1.0
    NamePrefix = HeavyC
    Mesh = ball_lg
    Material = BallMatA
    Mass = 2.5
    Restitution = 0.28
    Damping = 0.98
    UseGravity = true
    Collider = sphere
    ColliderRadius = 1.1
  EndTemplate
EndSpawner

BeginSpawner
  Name = SpawnerRight
  Position = 11.0, 8.0, 22.0
  SpawnDirection = 0.0, 0.0, -1.0
  DirectionRandomness = 0.18
  SpawnSpeed = 16.0
  SpeedRandomness = 0.3
  SpawnInterval = 0.28
  SpawnIntervalRandomness = 0.4
  PositionRandomness = 1.2
  MaxSpawns = -1
  BeginTemplate
    Weight = 1.0
    NamePrefix = BoltR
    Mesh = ball_sm
    Material = BallMatC
    Mass = 0.55
    Restitution = 0.32
    Damping = 0.97
    UseGravity = true
    Collider = sphere
    ColliderRadius = 0.55
  EndTemplate
EndSpawner

# ---- Lights ----

BeginLight
  Name = Key
  Type = sun
  Direction = 0.3, -0.8, 0.5
  Color = 1.0, 0.95, 0.88
  Intensity = 2.2
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 20.0, -15.0
  Color = 0.45, 0.55, 0.90
  Intensity = 300.0
  CastsShadows = false
EndLight

BeginCamera
  Name = MainCamera
  Position = 24.0, 16.0, 8.0
  Target = 0.0, 10.0, 0.0
  FOV = 70
EndCamera
