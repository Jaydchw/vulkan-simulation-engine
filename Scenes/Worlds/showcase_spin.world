# Spin Physics Showcase
# Demonstrates how angular velocity (spin) affects collisions after the
# rigid-body impulse upgrade. All objects fall onto the same floor.
#
# LEFT COLUMN    — Spheres with topspin / backspin.
#   Topspin ball accelerates forward on bounce; backspin reverses.
# CENTRE COLUMN  — Cylinders rolling with spin about their own axis.
# RIGHT COLUMN   — Boxes: one with sidespin, one with constant torque mid-flight.
# FAR RIGHT      — Control objects (zero angular velocity) for comparison.

BeginSettings
  ClearColor = 0.06, 0.06, 0.10, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
  KillboxEnabled = true
  KillboxY = -5.0
EndSettings

# ---- Materials ----

BeginTexture
  Name = tex_floor
  Type = checker
  ColorA = 0.35, 0.35, 0.38
  ColorB = 0.25, 0.25, 0.28
  Size = 256
  Divisions = 12
EndTexture

BeginMaterial
  Name = FloorMat
  AlbedoColor = 0.35, 0.35, 0.38
  Roughness = 0.78
  Metallic = 0.05
  AlbedoTexture = tex_floor
EndMaterial

BeginMaterial
  Name = TopspinMat
  AlbedoColor = 0.20, 0.65, 1.00
  Roughness = 0.20
  Metallic = 0.55
EndMaterial

BeginMaterial
  Name = BackspinMat
  AlbedoColor = 1.00, 0.30, 0.20
  Roughness = 0.22
  Metallic = 0.50
EndMaterial

BeginMaterial
  Name = SidespinMat
  AlbedoColor = 0.20, 0.88, 0.40
  Roughness = 0.20
  Metallic = 0.50
EndMaterial

BeginMaterial
  Name = CylMat
  AlbedoColor = 0.90, 0.65, 0.10
  Roughness = 0.28
  Metallic = 0.60
EndMaterial

BeginMaterial
  Name = BoxTorqueMat
  AlbedoColor = 0.75, 0.20, 0.90
  Roughness = 0.30
  Metallic = 0.45
EndMaterial

BeginMaterial
  Name = ControlMat
  AlbedoColor = 0.88, 0.88, 0.88
  Roughness = 0.25
  Metallic = 0.30
EndMaterial

BeginMaterial
  Name = RampMat
  AlbedoColor = 0.45, 0.42, 0.38
  Roughness = 0.70
  Metallic = 0.05
EndMaterial

# ---- Meshes ----

BeginMesh
  Name = floor_plane
  Type = plane
  Width = 80.0
  Height = 40.0
EndMesh

BeginMesh
  Name = unit_cube
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = ball_mesh
  Type = sphere
  Radius = 0.9
  Segments = 32
EndMesh

BeginMesh
  Name = cyl_mesh
  Type = cylinder
  Radius = 0.9
  Height = 1.8
  Segments = 24
EndMesh

# ---- Floor ----

BeginObject
  Name = Floor
  Position = 0.0, 0.0, 0.0
  Mesh = floor_plane
  Material = FloorMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 40.0, 0.0, 20.0
EndObject

# A low ramp in the centre — demonstrates spin deflection on an angled surface
BeginObject
  Name = Ramp
  Position = 0.0, 1.5, 5.0
  Rotation = 0.0, 0.0, -16.0
  Scale = 16.0, 0.6, 8.0
  Mesh = unit_cube
  Material = RampMat
  Collider = box
  ColliderHalfExtents = 8.0, 0.3, 4.0
EndObject

# ============================================================
# LEFT COLUMN — Spheres with angular velocity
# ============================================================

# Ball 1: Topspin (+Z angular velocity → forward roll on bounce)
BeginObject
  Name = Ball_Topspin
  Position = -18.0, 12.0, 0.0
  Mesh = ball_mesh
  Material = TopspinMat
  Physics = true
  Mass = 1.0
  Restitution = 0.65
  Friction = 0.5
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 0.0, 0.0, 8.0
  Collider = sphere
  ColliderRadius = 0.9
EndObject

# Ball 2: Backspin (−Z angular velocity → reverses on bounce)
BeginObject
  Name = Ball_Backspin
  Position = -14.0, 14.0, 0.0
  Mesh = ball_mesh
  Material = BackspinMat
  Physics = true
  Mass = 1.0
  Restitution = 0.65
  Friction = 0.5
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 0.0, 0.0, -8.0
  Collider = sphere
  ColliderRadius = 0.9
EndObject

# Ball 3: Strong sidespin (+X angular velocity → deflects sideways on bounce)
BeginObject
  Name = Ball_Sidespin
  Position = -10.0, 13.0, 0.0
  Mesh = ball_mesh
  Material = SidespinMat
  Physics = true
  Mass = 1.0
  Restitution = 0.65
  Friction = 0.5
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 8.0, 0.0, 0.0
  Collider = sphere
  ColliderRadius = 0.9
EndObject

# ============================================================
# CENTRE COLUMN — Cylinders with spin about their roll axis
# ============================================================

# Cyl 1: Rolls forward (spin matches roll direction)
BeginObject
  Name = Cyl_RollForward
  Position = -2.0, 10.0, 0.0
  Rotation = 0.0, 0.0, 90.0
  Mesh = cyl_mesh
  Material = CylMat
  Physics = true
  Mass = 1.5
  Restitution = 0.5
  Friction = 0.55
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 0.0, 0.0, 6.0
  Velocity = 2.5, 0.0, 0.0
  Collider = cylinder
  ColliderRadius = 0.9
  ColliderHeight = 1.8
EndObject

# Cyl 2: Counter-spin (fights against travel direction → brakes/reverses)
BeginObject
  Name = Cyl_CounterSpin
  Position = 2.0, 10.0, 3.0
  Rotation = 0.0, 0.0, 90.0
  Mesh = cyl_mesh
  Material = CylMat
  Physics = true
  Mass = 1.5
  Restitution = 0.5
  Friction = 0.55
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 0.0, 0.0, -6.0
  Velocity = 2.5, 0.0, 0.0
  Collider = cylinder
  ColliderRadius = 0.9
  ColliderHeight = 1.8
EndObject

# ============================================================
# RIGHT COLUMN — Boxes demonstrating torque and spin transfer
# ============================================================

# Box 1: Spinning on its vertical axis — when it hits the floor the
# angular momentum transfers as tangential friction into sliding motion
BeginObject
  Name = Box_VerticalSpin
  Position = 10.0, 12.0, 0.0
  Mesh = unit_cube
  Scale = 1.6, 1.6, 1.6
  Material = BoxTorqueMat
  Physics = true
  Mass = 2.0
  Restitution = 0.40
  Friction = 0.6
  Damping = 0.99
  UseGravity = true
  AngularVelocity = 0.0, 12.0, 0.0
  Collider = box
  ColliderHalfExtents = 0.8, 0.8, 0.8
EndObject

# Box 2: Constant torque applied throughout flight — never stops spinning
BeginObject
  Name = Box_ConstantTorque
  Position = 15.0, 14.0, 0.0
  Scale = 1.6, 1.6, 1.6
  Mesh = unit_cube
  Material = BoxTorqueMat
  Physics = true
  Mass = 2.0
  Restitution = 0.40
  Friction = 0.6
  Damping = 0.99
  UseGravity = true
  ConstantTorque = 0.0, 8.0, 4.0
  Collider = box
  ColliderHalfExtents = 0.8, 0.8, 0.8
EndObject

# ============================================================
# FAR RIGHT — Control objects (no spin) for visual comparison
# ============================================================

BeginObject
  Name = Control_Ball
  Position = 22.0, 12.0, 0.0
  Mesh = ball_mesh
  Material = ControlMat
  Physics = true
  Mass = 1.0
  Restitution = 0.65
  Friction = 0.5
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.9
EndObject

BeginObject
  Name = Control_Box
  Position = 26.0, 13.0, 0.0
  Scale = 1.6, 1.6, 1.6
  Mesh = unit_cube
  Material = ControlMat
  Physics = true
  Mass = 2.0
  Restitution = 0.40
  Friction = 0.5
  Damping = 0.99
  UseGravity = true
  Collider = box
  ColliderHalfExtents = 0.8, 0.8, 0.8
EndObject

# ---- Lights ----

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.4, -0.85, 0.35
  Color = 1.0, 0.97, 0.90
  Intensity = 2.5
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 25.0, -10.0
  Color = 0.45, 0.55, 0.90
  Intensity = 500.0
  Linear = 0.03
  Quadratic = 0.005
  CastsShadows = false
EndLight

BeginCamera
  Name = MainCamera
  Position = 4.0, 18.0, -34.0
  Target = 4.0, 4.0, 0.0
  FOV = 74
EndCamera
