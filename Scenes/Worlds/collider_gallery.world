# Collider Showcase
# One row of dynamic objects per collider type — all falling onto a shared ground
# and bouncing off static box platforms, so every shape pair can be observed.
#
#   Row Z=-10 : Spheres
#   Row Z= -5 : Boxes  (pre-rotated to tumble and land on edges/faces)
#   Row Z=  0 : Cylinders (upright + on their side)
#   Row Z=  5 : Capsules
#   Row Z= 10 : Cones
#
# Two static box shelves interrupt the fall at mid-height so shapes collide
# with a box surface before hitting the ground.

BeginSettings
  ClearColor = 0.04, 0.04, 0.08, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

# ── Materials ──────────────────────────────────────────────────────────────────

BeginTexture
  Name = GridTex
  Type = checker
  ColorA = 0.22, 0.22, 0.28
  ColorB = 0.10, 0.10, 0.13
  Divisions = 16
  Size = 256
EndTexture

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.18, 0.18, 0.22
  Roughness = 0.92
  Metallic = 0.0
  AlbedoTexture = GridTex
EndMaterial

BeginMaterial
  Name = ShelfMat
  AlbedoColor = 0.30, 0.28, 0.35
  Roughness = 0.80
  Metallic = 0.05
EndMaterial

BeginMaterial
  Name = SphereMat
  AlbedoColor = 0.15, 0.55, 1.00
  Roughness = 0.18
  Metallic = 0.45
EndMaterial

BeginMaterial
  Name = BoxMat
  AlbedoColor = 1.00, 0.50, 0.10
  Roughness = 0.55
  Metallic = 0.05
EndMaterial

BeginMaterial
  Name = CylMat
  AlbedoColor = 0.95, 0.85, 0.05
  Roughness = 0.35
  Metallic = 0.15
EndMaterial

BeginMaterial
  Name = CapsuleMat
  AlbedoColor = 0.20, 0.90, 0.40
  Roughness = 0.25
  Metallic = 0.20
EndMaterial

BeginMaterial
  Name = ConeMat
  AlbedoColor = 0.90, 0.20, 0.55
  Roughness = 0.30
  Metallic = 0.25
EndMaterial

# ── Meshes ─────────────────────────────────────────────────────────────────────

BeginMesh
  Name = Ground
  Type = plane
  Width = 60.0
  Height = 30.0
EndMesh

BeginMesh
  Name = ShelfMesh
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = Ball
  Type = sphere
  Radius = 0.50
  Segments = 24
EndMesh

BeginMesh
  Name = BoxMesh
  Type = cube
  Size = 1.0
EndMesh

BeginMesh
  Name = CylMesh
  Type = cylinder
  Radius = 0.42
  Height = 1.0
  Segments = 24
EndMesh

BeginMesh
  Name = CapMesh
  Type = capsule
  Radius = 0.36
  Height = 1.2
  Segments = 24
EndMesh

BeginMesh
  Name = ConeMesh
  Type = cone
  Radius = 0.48
  Height = 1.1
  Segments = 24
EndMesh

# ── Static geometry ────────────────────────────────────────────────────────────

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Ground
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 30.0, 0.0, 15.0
EndObject

# Left shelf (catches rows Z=-10 and Z=-5)
BeginObject
  Name = LeftShelf
  Position = -8.0, 5.0, -7.5
  Scale = 14.0, 1.0, 8.0
  Mesh = ShelfMesh
  Material = ShelfMat
  Collider = box
  ColliderHalfExtents = 7.0, 0.5, 4.0
EndObject

# Right shelf (catches rows Z=5 and Z=10)
BeginObject
  Name = RightShelf
  Position = 8.0, 5.0, 7.5
  Scale = 14.0, 1.0, 8.0
  Mesh = ShelfMesh
  Material = ShelfMat
  Collider = box
  ColliderHalfExtents = 7.0, 0.5, 4.0
EndObject

# Central dividing wall — boxes and spheres can bounce off this
BeginObject
  Name = CentreWall
  Position = 0.0, 3.5, 0.0
  Rotation = 0.0, 0.0, 0.0
  Scale = 1.5, 7.0, 22.0
  Mesh = ShelfMesh
  Material = ShelfMat
  Collider = box
  ColliderHalfExtents = 0.75, 3.5, 11.0
EndObject

# ── Row 1: Spheres (Z = -10) ───────────────────────────────────────────────────

BeginObject
  Name = Sphere A
  Position = -9.0, 16.0, -10.0
  Mesh = Ball
  Material = SphereMat
  Mass = 0.8
  Restitution = 0.75
  Friction = 0.30
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.50
EndObject

BeginObject
  Name = Sphere B
  Position = -5.0, 18.0, -10.0
  Mesh = Ball
  Material = SphereMat
  Mass = 1.5
  Restitution = 0.55
  Friction = 0.35
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.50
