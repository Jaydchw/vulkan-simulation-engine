  Mass = 1.0
  Restitution = 0.65
  Friction = 0.30
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.50
EndObject

# ── Row 2: Boxes (Z = -5) ─────────────────────────────────────────────────────
# Pre-rotated so they tumble and land on different faces, exercising OBB-plane
# and OBB-OBB contacts.

BeginObject
