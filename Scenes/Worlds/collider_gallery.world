# ── Lighting ───────────────────────────────────────────────────────────────────

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.40, -1.0, 0.35
  Color = 1.0, 0.96, 0.88
  Intensity = 2.4
  CastsShadows = true
EndLight

BeginLight
