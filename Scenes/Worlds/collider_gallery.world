  Mass = 0.5
  Restitution = 0.85
  Friction = 0.20
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.50
EndObject

BeginObject
  Name = Sphere D
  Position = 3.0, 17.0, -10.0
  Mesh = Ball
  Material = SphereMat
  Mass = 2.0
  Restitution = 0.40
  Friction = 0.50
  Damping = 0.99
  UseGravity = true
  Collider = sphere
  ColliderRadius = 0.50
EndObject

BeginObject
  Name = Sphere E
  Position = 7.0, 19.0, -10.0
  Mesh = Ball
