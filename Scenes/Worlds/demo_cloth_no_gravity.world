# Cloth No Gravity Demo
# Cloth with gravity disabled, driven entirely by wind.
# Pinned at all four corners — floats and ripples like a flag in space.

BeginSettings
  ClearColor = 0.55, 0.75, 0.95, 1.0
  TimeSpeed = 1.0
  SimulationHz = 120
EndSettings

BeginMaterial
  Name = ClothMat
  AlbedoColor = 0.95, 0.95, 0.95
  Roughness = 0.6
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = GroundMat
  AlbedoColor = 0.45, 0.55, 0.45
  Roughness = 0.9
  Metallic = 0.0
EndMaterial

BeginMaterial
  Name = BallMat
  AlbedoColor = 0.9, 0.4, 0.2
  Roughness = 0.3
  Metallic = 0.2
EndMaterial

BeginMesh
  Name = Floor
  Type = plane
  Width = 60.0
  Height = 60.0
EndMesh

BeginMesh
  Name = Ball
  Type = sphere
  Radius = 2.0
  Segments = 32
EndMesh

BeginObject
  Name = Ground
  Position = 0.0, 0.0, 0.0
  Mesh = Floor
  Material = GroundMat
  Collider = plane
  ColliderNormal = 0.0, 1.0, 0.0
  ColliderHalfExtents = 30.0, 0.0, 30.0
EndObject

BeginObject
  Name = Floating Ball
  Position = 0.0, 12.0, 0.5
  Mesh = Ball
  Material = BallMat
  Physics = true
  Mass = 3.0
  Restitution = 0.5
  UseGravity = false
  Collider = sphere
  ColliderRadius = 2.0
  Velocity = 0.0, 0.0, 0.0
EndObject

BeginCloth
  Name = Floating Cloth
  Position = 0.0, 12.0, 0.0
  Material = ClothMat
  ResolutionX = 16
  ResolutionZ = 16
  Width = 11.0
  ClothHeight = 11.0
  StructuralStiffness = 0.75
  BendingStiffness = 0.04
  Damping = 0.98
  ParticleMass = 0.05
  UseGravity = false
  Hinge = None
  Wind = 2.0, 0.5, 0.5
EndCloth

BeginLight
  Name = Sun
  Type = sun
  Direction = 0.2, -1.0, 0.3
  Color = 1.0, 1.0, 0.95
  Intensity = 3.0
  CastsShadows = true
EndLight

BeginLight
  Name = Fill
  Type = point
  Position = 0.0, 20.0, 10.0
  Color = 0.7, 0.8, 1.0
  Intensity = 100.0
  CastsShadows = false
EndLight
